Bootstrap: docker
From: python:3.11-slim-bookworm

# Build from the repository root. Copy only source, never the host environment.
%files
    pyproject.toml /opt/CAAT/pyproject.toml
    poetry.lock /opt/CAAT/poetry.lock
    README.md /opt/CAAT/README.md
    LICENSE /opt/CAAT/LICENSE
    colabfold /opt/CAAT/colabfold
    scripts /opt/CAAT/scripts
    dashboard /opt/CAAT/dashboard
    alphafold /opt/CAAT/alphafold
    tests /opt/CAAT/tests
    test-data /opt/CAAT/test-data
    images /opt/CAAT/images

%post
    sh /opt/CAAT/images/install.sh

%environment
    export LC_ALL=C.UTF-8
    export PATH="/opt/CAAT/.venv/bin:/opt/CAAT:$PATH"
    export MPLBACKEND=Agg
    export PYTHONNOUSERSITE=1

%runscript
    exec /opt/CAAT/images/entrypoint.sh "$@"

%test
    export JAX_PLATFORMS=cpu
    python /opt/CAAT/images/smoke_test.py

%help
    Run from a writable directory, using --nv for an NVIDIA GPU:
      apptainer run --cleanenv --nv caat.sif scripts/run_e2e_pipeline.py [OPTIONS]
    Use --data-dir to select a persistent model-weight directory.
    For CPU-only execution, set --env JAX_PLATFORMS=cpu.
